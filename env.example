# Copiar este archivo como ".env" y completar los datos de tu base.
# El archivo .env NO se sube al repositorio.
#
# Formato: postgresql+asyncpg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
# Si la contraseña tiene caracteres especiales (@ : / # %), codificarlos
# (por ejemplo, @ se escribe %40).
DATABASE_URL=postgresql+asyncpg://postgres:CONTRASENA@localhost:5432/veterinaria

# Opcional: "true" muestra en la consola cada consulta SQL (útil para el caso C-07).
SQL_ECHO=false
