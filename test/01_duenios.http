@host = http://localhost:8000

# Correr DESPUÉS de:  python reiniciar.py
# Datos de partida: dueño 1 (Ana, con ficha) y dueño 2 (Bruno, sin ficha).

### Alta de un dueño
# Esperado: 201 con id, nombre, email y ficha null
POST {{host}}/duenios/
Content-Type: application/json

{ "nombre": "Carla Díaz", "email": "carla@example.com" }

### C-01: parámetro de ruta que no es entero
# Esperado: 422, sin ejecutar el handler
GET {{host}}/duenios/abc

### C-02: email de dueño repetido
# Esperado: 409 con mensaje propio ("Ya existe un dueño con el email ...")
POST {{host}}/duenios/
Content-Type: application/json

{ "nombre": "Otra Ana", "email": "ana@example.com" }

### Alta con cuerpo inválido (email sin formato)
# Esperado: 422
POST {{host}}/duenios/
Content-Type: application/json

{ "nombre": "Sin Email Válido", "email": "esto-no-es-un-email" }

### Detalle de un dueño con ficha
# Esperado: 200, con "ficha" como objeto
GET {{host}}/duenios/1

### Detalle de un dueño sin ficha
# Esperado: 200, con "ficha": null
GET {{host}}/duenios/2

### Dueño inexistente
# Esperado: 404
GET {{host}}/duenios/9999

### PATCH parcial: solo cambia el nombre, el email queda igual
# Esperado: 200, nombre nuevo y email "bruno@example.com" sin cambios
PATCH {{host}}/duenios/2
Content-Type: application/json

{ "nombre": "Bruno Pérez Díaz" }

### PATCH con email de otro dueño
# Esperado: 409
PATCH {{host}}/duenios/2
Content-Type: application/json

{ "email": "ana@example.com" }

### PATCH de un dueño inexistente
# Esperado: 404
PATCH {{host}}/duenios/9999
Content-Type: application/json

{ "nombre": "Nadie" }

### C-03: segunda ficha para el mismo dueño (el dueño 1 ya tiene)
# Esperado: 409
POST {{host}}/duenios/1/ficha
Content-Type: application/json

{ "telefono": "261-555-9999", "direccion": "Otra calle 456" }

### Primera ficha para el dueño 2
# Esperado: 201
POST {{host}}/duenios/2/ficha
Content-Type: application/json

{ "telefono": "261-555-0202", "direccion": "Belgrano 789" }

### Ficha para un dueño inexistente
# Esperado: 404
POST {{host}}/duenios/9999/ficha
Content-Type: application/json

{ "telefono": "261-555-0000", "direccion": "Sin dueño 1" }

### Mascotas del dueño 1
# Esperado: 200 con Toby y Michi
GET {{host}}/duenios/1/mascotas

### Mascotas de un dueño inexistente
# Esperado: 404
GET {{host}}/duenios/9999/mascotas

### C-05 (primera parte): borrar un dueño que tiene mascotas
# Esperado: 409 (ON DELETE RESTRICT)
DELETE {{host}}/duenios/1

### Borrar un dueño sin mascotas (el que se creó arriba, con id 3)
# Esperado: 204. Su ficha, si la tuviera, se borra sola (ON DELETE CASCADE).
DELETE {{host}}/duenios/3

### Borrar un dueño inexistente
# Esperado: 404
DELETE {{host}}/duenios/9999
